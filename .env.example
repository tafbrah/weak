# ==========================================
# Loopwerk — Environment Variables
# Copy this file to .env and fill in the values
# ==========================================

# ---------- Database ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=app_db
# For local development (Docker uses db:5432)
DATABASE_URL=postgresql://postgres:CHANGE_ME_strong_password@127.0.0.1:5432/app_db

# ---------- Authentication ----------
# Change this to a long random string (used to sign session tokens)
SESSION_SECRET=CHANGE_ME_long_random_secret_string
# Admin console credentials
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_admin_password

# ---------- Site ----------
# Your OVHcloud domain (used for canonical URLs, OG images)
NEXT_PUBLIC_SITE_URL=https://yourdomain.ovh.net
